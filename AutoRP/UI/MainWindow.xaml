<Window x:Class="AutoRP.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoRP"
        Width="520"
        Height="900"
        MinWidth="420"
        MinHeight="360"
        MaxWidth="900"
        MaxHeight="1000"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
            <Grid Margin="32" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleStyle}" Text="AutoRP" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" Style="{StaticResource SubtitleStyle}" Text="Automatic Discord Rich Presence" />

        <Border Grid.Row="2" Margin="0,28,0,24" Padding="18" Style="{StaticResource StatusCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource LabelStyle}" Text="FOREGROUND APPLICATION" />
                <TextBlock x:Name="DetectionStatusText" Margin="0,8,0,0" Style="{StaticResource StatusTextStyle}" Text="Detecting..." />
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource LabelStyle}" Text="APPLICATION" />
                    <TextBlock x:Name="ActiveApplicationText" Grid.Column="1" Style="{StaticResource StatusTextStyle}" Text="-" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Style="{StaticResource LabelStyle}" Text="PROCESS" />
                    <TextBlock x:Name="ProcessText" Grid.Row="1" Grid.Column="1" Style="{StaticResource StatusTextStyle}" Text="-" />
                    <TextBlock Grid.Row="2" Style="{StaticResource LabelStyle}" Text="PID" />
                    <TextBlock x:Name="ProcessIdText" Grid.Row="2" Grid.Column="1" Style="{StaticResource StatusTextStyle}" Text="-" />
                    <TextBlock Grid.Row="3" Style="{StaticResource LabelStyle}" Text="WINDOW" />
                    <TextBlock x:Name="WindowTitleText" Grid.Row="3" Grid.Column="1" Style="{StaticResource StatusTextStyle}" Text="-" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Margin="0,0,0,24" Padding="14" Style="{StaticResource StatusCardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource LabelStyle}" Text="AUTOMATIC SWITCHING" />
                    <TextBlock x:Name="MatchedProfileText" Margin="0,6,0,0" Style="{StaticResource StatusTextStyle}" Text="No matched profile" />
                    <TextBlock x:Name="SwitchStatusText" Margin="0,4,0,0" Style="{StaticResource FooterStyle}" Text="Automatic switching is ready." TextWrapping="Wrap" />
                    <TextBlock x:Name="LastSwitchText" Margin="0,4,0,0" Style="{StaticResource FooterStyle}" Text="Last switch: never" />
                </StackPanel>
                <CheckBox x:Name="AutomaticSwitchingCheckBox" Grid.Column="1" VerticalAlignment="Top" Margin="16,0,0,0" Content="ON" IsChecked="True" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Margin="0,0,0,16" Padding="14" Style="{StaticResource StatusCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource LabelStyle}" Text="SETTINGS" />
                <TextBlock Margin="0,8,0,4" Style="{StaticResource FooterStyle}" Text="STARTUP" />
                <CheckBox x:Name="StartWithWindowsCheckBox" Content="Start AutoRP with Windows" />
                <TextBlock Margin="0,12,0,4" Style="{StaticResource FooterStyle}" Text="BEHAVIOR" />
                <CheckBox x:Name="CloseToTrayCheckBox" Content="Close to system tray" />
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Margin="0,0,0,16" Padding="14" Style="{StaticResource StatusCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource LabelStyle}" Text="RPC PROFILES" />
                <ListBox x:Name="ProfileList" Height="190" Margin="0,10,0,0" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="58" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Grid.Column="1" Text="{Binding ProcessNames}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="{Binding Priority, StringFormat='P{0}'}" />
                                <TextBlock Grid.Column="3" Margin="0,18,0,0" HorizontalAlignment="Right" Text="{Binding Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <WrapPanel Grid.Row="6" Margin="0,0,0,16">
            <Button Margin="0,0,8,8" Click="OnAddProfileClick" Content="Add Profile" />
            <Button Margin="0,0,8,8" Click="OnEditProfileClick" Content="Edit" />
            <Button Margin="0,0,8,8" Click="OnDeleteProfileClick" Content="Delete" />
            <Button Margin="0,0,8,8" Click="OnToggleProfileClick" Content="Enable / Disable" />
            <Button Margin="0,0,8,8" Click="OnTestProfileClick" Content="Test Presence" />
            <Button Margin="0,0,8,8" Click="OnConnectClick" Content="Connect" />
            <Button Margin="0,0,8,8" Click="OnDisconnectClick" Content="Disconnect" />
            <Button Margin="0,0,8,8" Click="OnSetSamplePresenceClick" Content="Set Test Presence" />
            <Button Margin="0,0,8,8" Click="OnClearPresenceClick" Content="Clear Presence" />
        </WrapPanel>

        <TextBlock Grid.Row="7" Style="{StaticResource FooterStyle}" Text="DISCORD RPC STATUS" />
        <TextBlock x:Name="RpcStatusText" Grid.Row="8" Margin="0,4,0,0" Style="{StaticResource FooterStyle}" Text="Disconnected" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
